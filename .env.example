# Copy to .env and fill in real values. .env is gitignored.

# Anthropic API key for Claude Sonnet 4.6 (Computer Use beta).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the planner. Defaults to claude-sonnet-4-6.
# CUA_LARK_MODEL=claude-sonnet-4-6

# Optional: max steps per agent run before hard abort. Defaults to 20.
# CUA_LARK_MAX_STEPS=20

# Optional: Feishu Electron remote debug port for CDP (M2+). Defaults to 9222.
# FEISHU_CDP_PORT=9222
